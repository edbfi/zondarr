# =============================================================================
# Zondarr — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values.
# All variables with defaults are optional.

# -----------------------------------------------------------------------------
# Security (REQUIRED)
# -----------------------------------------------------------------------------

# Secret key for signing tokens and sessions. Must be at least 32 characters.
# Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Note: The dev CLI (uv run dev_cli) auto-generates this if not set.
SECRET_KEY=

# Set to true when serving over HTTPS to enforce the Secure flag on cookies.
# Default: false.
# SECURE_COOKIES=true

# Trusted origin for CSRF protection (e.g., https://zondarr.example.com).
# Required when using a reverse proxy with a custom domain over HTTPS.
# CSRF_ORIGIN=https://zondarr.example.com

# -----------------------------------------------------------------------------
# Bootstrap / Initial Setup
# -----------------------------------------------------------------------------

# Fixed bootstrap token for initial admin account creation.
# If not set, the server auto-generates a random token on startup when no
# admin account exists (printed to the console log).
# BOOTSTRAP_TOKEN=your-fixed-token

# File path where the backend writes the bootstrap token so the frontend SSR
# can read it directly from disk (no HTTP endpoint needed).
# The dev CLI sets this automatically. In Docker, the s6 init script writes
# to ${CONFIG_DIR}/data/.bootstrap_token by default.
# BOOTSTRAP_TOKEN_FILE=/path/to/.bootstrap_token

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Database connection URL.
# SQLite (dev):      sqlite+aiosqlite:///./zondarr.db
# PostgreSQL (prod): postgresql+asyncpg://user:pass@host:5432/zondarr
DATABASE_URL=sqlite+aiosqlite:///./zondarr.db

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Host and port for the backend server.
HOST=0.0.0.0
PORT=8000

# Enable debug mode. Accepts: true, 1, yes (case-insensitive).
DEBUG=false

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins. Empty = CORS disabled.
# For local development: http://localhost:5173
# For production: https://yourdomain.com
# The dev CLI (uv run dev_cli) sets this automatically.
# CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Background Tasks
# -----------------------------------------------------------------------------

# How often (in seconds) to check for expired invitations. Minimum: 60.
# Default: 3600 (1 hour). Only set to override the built-in default.
# EXPIRATION_CHECK_INTERVAL_SECONDS=3600

# How often (in seconds) to sync media server state. Minimum: 60.
# Default: 900 (15 minutes). Only set to override the built-in default.
# SYNC_INTERVAL_SECONDS=900

# -----------------------------------------------------------------------------
# Media Server Credentials (optional, override database values)
# -----------------------------------------------------------------------------

# When set, these environment variables take precedence over credentials
# stored in the database. Useful for Docker/container deployments where
# secrets are injected via environment variables.
# Each variable is independent: e.g. setting PLEX_URL without PLEX_TOKEN
# will override only the URL, keeping the token from the database.

# PLEX_URL=http://plex.local:32400
# PLEX_TOKEN=your-plex-token
# JELLYFIN_URL=http://jellyfin.local:8096
# JELLYFIN_API_KEY=your-jellyfin-api-key

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------

# Backend API base URL for the frontend. When empty (default in Docker), the
# frontend proxies /api/* requests through SvelteKit — no CORS needed.
# The dev CLI sets this automatically to http://localhost:<port>.
# Only set this if you want the browser to talk directly to the backend
# (requires CORS_ORIGINS to be configured too).
# PUBLIC_API_URL=http://localhost:8000

# Internal URL for server-side requests (SSR + API proxy).
# In Docker, this defaults to http://localhost:8000 (set by init script).
# Only needed if the backend is on a different host/port from the frontend server.
# INTERNAL_API_URL=http://localhost:8000

# Public origin of the frontend (scheme, host and port; no path or credentials).
# Plain-HTTP deployments must set it, or every write (login, logout, saves) is
# rejected with 403: without it the frontend assumes https://<Host>, which is
# right only behind a TLS proxy that preserves Host. Setting it makes
# `bun run start` (scripts/serve.ts) front the SvelteKit server with this origin.
# A malformed value stops the frontend at startup. Use the same value as
# CSRF_ORIGIN, which the backend reads separately.
# ORIGIN=http://192.168.1.10:3000

# Behind your own trusted reverse proxy, instead of ORIGIN you may name the
# headers that proxy sets: PROTOCOL_HEADER (e.g. x-forwarded-proto) and
# HOST_HEADER (e.g. x-forwarded-host); ADDRESS_HEADER and XFF_DEPTH for the
# client address. Only set them when every request passes through that proxy:
# a client that reaches the frontend directly can forge them.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host

# Idle timeout for frontend connections in seconds (0-255). IDLE_TIMEOUT is
# still accepted as the older name. Event streams (the log viewer) are exempt.
# CONNECTION_IDLE_TIMEOUT=10
