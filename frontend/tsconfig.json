{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"target": "ES2022",
		"noUncheckedIndexedAccess": true,
		"paths": { "$lib": ["./src/lib"], "$lib/*": ["./src/lib/*"] }
	},
	"include": ["src", "vite.config.ts", "vitest-setup.ts"]
}
