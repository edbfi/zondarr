{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun run check:native",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest --run --maxWorkers=4",
		"test:watch": "vitest",
		"generate:api": "openapi-typescript http://localhost:8000/docs/openapi.json -o src/lib/api/types.d.ts",
		"check:biome": "biome ci ..",
		"start": "NODE_ENV=production bun ./build/index.js",
		"smoke:install": "playwright install chromium",
		"smoke:browser": "playwright test --config playwright.smoke.config.ts",
		"check:native": "bunx --bun svelte-check --tsgo --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.47.0",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.7",
		"@types/jsdom": "30.0.0",
		"@unocss/preset-icons": "66.10.5",
		"@unocss/transformer-variant-group": "66.10.5",
		"bits-ui": "2.19.2",
		"fast-check": "4.10.1",
		"jsdom": "30.1.0",
		"mode-watcher": "1.1.0",
		"openapi-typescript": "7.13.0",
		"svelte": "5.57.1",
		"svelte-adapter-bun": "1.0.1",
		"svelte-check": "4.7.6",
		"svelte-sonner": "1.2.1",
		"typescript": "6.0.3",
		"unocss": "66.10.5",
		"unocss-preset-animations": "1.3.0",
		"unocss-preset-shadcn": "1.0.1",
		"vite": "8.3.0",
		"vitest": "5.0.1",
		"zod": "4.6.5",
		"@playwright/test": "1.63.0",
		"@typescript/native": "npm:typescript@7.0.2"
	},
	"dependencies": {
		"clsx": "2.1.1",
		"dompurify": "3.4.15",
		"marked": "18.0.13",
		"openapi-fetch": "0.17.0",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1"
	},
	"packageManager": "bun@1.4.2"
}
