{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": [
			"**",
			"!!**/build",
			"!**/.svelte-kit",
			"!**/node_modules",
			"!**/*.db",
			"!**/bun.lock",
			"!**/src/lib/components/ui/form/form-field.svelte",
			"!**/src/lib/components/ui/form/form-fieldset.svelte",
			"!**/src/lib/components/ui/form/form-element-field.svelte"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "warn",
				"noImplicitAnyLet": "warn"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "none"
		}
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true
		}
	},
	"overrides": [
		{
			"includes": [
				"src/lib/components/dashboard/recent-activity.svelte",
				"src/lib/components/servers/create-server-dialog.svelte",
				"src/lib/components/settings/link-provider-card.svelte",
				"src/lib/components/setup/step-indicator.svelte",
				"src/lib/components/setup/step-server.svelte",
				"src/lib/components/wizard/step-editor.svelte",
				"src/lib/components/wizard/wizard-builder.svelte",
				"src/lib/components/wizard/wizard-shell.svelte"
			],
			"formatter": {
				"enabled": false
			}
		}
	]
}
