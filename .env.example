# =============================================================================
# Zondarr — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values.
# All variables with defaults are optional.

# -----------------------------------------------------------------------------
# Security (REQUIRED)
# -----------------------------------------------------------------------------

# Secret key for signing tokens and sessions. Must be at least 32 characters.
# Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Note: The dev CLI (uv run dev_cli) auto-generates this if not set.
SECRET_KEY=

# Trusted origin for the backend's CSRF check: the address people open in the
# browser, the same value as ORIGIN (Frontend section below). The Docker image
# defaults it to ORIGIN; otherwise set it to the same value. An origin stored
# during first-run setup is used when neither is set.
# CSRF_ORIGIN=http://192.168.1.10:3000

# Secure flag on the cookies the backend sets. Browser cookies follow ORIGIN's
# scheme: the frontend relays the backend's cookies with Secure exactly when the
# public origin is https, whatever this says. SECURE_COOKIES only matters for
# clients that call the backend port directly. Default: false.
# SECURE_COOKIES=true

# -----------------------------------------------------------------------------
# Bootstrap / Initial Setup
# -----------------------------------------------------------------------------

# Fixed bootstrap token for initial admin account creation.
# If not set, the server auto-generates a random token on startup when no
# admin account exists (printed to the console log).
# BOOTSTRAP_TOKEN=your-fixed-token

# File path where the backend writes the bootstrap token so the frontend SSR
# can read it directly from disk (no HTTP endpoint needed).
# The dev CLI sets this automatically. In Docker, the s6 init script writes
# to ${CONFIG_DIR}/data/.bootstrap_token by default.
# BOOTSTRAP_TOKEN_FILE=/path/to/.bootstrap_token

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Database connection URL.
# SQLite (dev):      sqlite+aiosqlite:///./zondarr.db
# PostgreSQL (prod): postgresql+asyncpg://user:pass@host:5432/zondarr
DATABASE_URL=sqlite+aiosqlite:///./zondarr.db

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Host and port for the backend server.
HOST=0.0.0.0
PORT=8000

# Enable debug mode. Accepts: true, 1, yes (case-insensitive).
DEBUG=false

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins. Empty = CORS disabled.
# For local development: http://localhost:5173
# For production: https://yourdomain.com
# The dev CLI (uv run dev_cli) sets this automatically.
# CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Background Tasks
# -----------------------------------------------------------------------------

# How often (in seconds) to check for expired invitations. Minimum: 60.
# Default: 3600 (1 hour). Only set to override the built-in default.
# EXPIRATION_CHECK_INTERVAL_SECONDS=3600

# How often (in seconds) to sync media server state. Minimum: 60.
# Default: 900 (15 minutes). Only set to override the built-in default.
# SYNC_INTERVAL_SECONDS=900

# -----------------------------------------------------------------------------
# Media Server Credentials (optional, override database values)
# -----------------------------------------------------------------------------

# When set, these environment variables take precedence over credentials
# stored in the database. Useful for Docker/container deployments where
# secrets are injected via environment variables.
# Each variable is independent: e.g. setting PLEX_URL without PLEX_TOKEN
# will override only the URL, keeping the token from the database.

# PLEX_URL=http://plex.local:32400
# PLEX_TOKEN=your-plex-token
# JELLYFIN_URL=http://jellyfin.local:8096
# JELLYFIN_API_KEY=your-jellyfin-api-key

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------

# Backend API base URL for the frontend. When empty (default in Docker), the
# frontend proxies /api/* requests through SvelteKit — no CORS needed.
# The dev CLI sets this automatically to http://localhost:<port>.
# Only set this if you want the browser to talk directly to the backend
# (requires CORS_ORIGINS to be configured too).
# PUBLIC_API_URL=http://localhost:8000

# Internal URL for server-side requests (SSR + API proxy).
# In Docker, this defaults to http://localhost:8000 (set by init script).
# Only needed if the backend is on a different host/port from the frontend server.
# INTERNAL_API_URL=http://localhost:8000

# Public origin: the address people open in the browser (scheme, host and port).
# Required for plain HTTP: without it the frontend assumes HTTPS behind a proxy
# that preserves the Host header, so over plain HTTP signing in and saving
# changes (including first-run setup) fail, and a startup warning says so.
# Leave it unset only behind an HTTPS reverse proxy that passes the original
# Host. It must be a bare http(s) origin (no path, query, fragment or
# credentials), or the frontend refuses to start; case, a default port and a
# trailing / are normalized. Setting it makes the frontend server
# (`NODE_ENV=production bun scripts/serve.ts` from frontend/; not `bun run start`,
# under which Bun 1.4.2's default shell delivers one Ctrl+C twice and skips the
# SHUTDOWN_TIMEOUT drain) front the SvelteKit server with this origin. Set
# CSRF_ORIGIN to the same value.
# Every write through the frontend (POST, PUT, PATCH, DELETE) must send an
# Origin header equal to this origin: browsers do; scripts and API clients that
# write through the frontend port must too, or they get 403.
# ORIGIN=http://192.168.1.10:3000

# Behind a reverse proxy: set ADDRESS_HEADER=x-forwarded-for, with XFF_DEPTH the
# number of proxies (default 1), only when every request goes through them;
# otherwise a client can forge its address.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# Only without ORIGIN, behind a trusted proxy that sets them: the headers that
# carry the public scheme and host. A client that reaches the frontend directly
# can forge them. ORIGIN wins over them.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host

# Seconds a stopping frontend waits for open requests (such as the log viewer's
# stream) before closing them. Default: 30. The Docker image sets a shorter
# default that fits Docker's stop timeout. With ORIGIN set, the frontend exits
# at that deadline even if the app is still waiting on the backend.
# SHUTDOWN_TIMEOUT=30

# Largest request body the frontend accepts (K, M or G suffix). Default: 512K.
# BODY_SIZE_LIMIT=512K

# Idle timeout for frontend connections in seconds (0-255). IDLE_TIMEOUT is
# still accepted as the older name. Event streams (the log viewer) are exempt.
# CONNECTION_IDLE_TIMEOUT=10
