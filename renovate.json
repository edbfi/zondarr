{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>edbfi/automation//default.json#v3.0.1",
    "github>edbfi/automation//mixed.json#v3.0.1"
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "ruff"
      ],
      "groupName": "ruff"
    },
    {
      "description": "Keep direct npm versions exact: post-artifact minimumReleaseAge re-extraction is unavailable (renovatebot/renovate#45284).",
      "matchManagers": [
        "npm",
        "bun"
      ],
      "rangeStrategy": "pin"
    }
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "automergeStrategy": "rebase"
}
